# Copy to .env.local for local development; never commit real credentials.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional local Vite shadow evaluation only; never use VITE_ prefixes for these values.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-supported-gemini-model-id
PROOFPILOT_DISABLE_GEMINI_SHADOW=true
